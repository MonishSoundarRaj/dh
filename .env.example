# Copy this file to .env and put in YOUR OWN key:   cp .env.example .env
# mini_harness.py and the steps/ files read .env automatically. .env is git-ignored: never commit it.
# Anything you export in the terminal wins over this file.

# Claude, as in our class demo (key from console.anthropic.com):
MINI_BASE_URL=https://api.anthropic.com/v1
MINI_MODEL=claude-opus-5-5
MINI_EFFORT=medium
MINI_API_KEY=sk-ant-...

# Or DeepSeek, the default and cheapest: delete the four lines above and use
# DEEPSEEK_API_KEY=sk-...
